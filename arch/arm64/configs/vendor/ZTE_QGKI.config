# Boot Mode
CONFIG_ZTE_BOOT_MODE=y

# CFG Helper
CONFIG_VENDOR_CONFIG_HELPER=y

# CFI
CONFIG_CFI_PERMISSIVE=y

# Common
CONFIG_VENDOR_COMMON_COMPILE=y

# Debug Policy
CONFIG_VENDOR_DEBUG_POLICY=y

# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_ZTE_FINGERAREA_A30PRO=y

# IMEM
CONFIG_VENDOR_IMEM_INFO=y

# Lcd
CONFIG_ZTE_LCD_COMMON_FUNCTION=y
CONFIG_ZTE_LCD_BACKLIGHT_LEVEL_CURVE=y
CONFIG_ZTE_LCD_HBM_CTRL=y
CONFIG_ZTE_LCD_COLOR_GAMUT_CTRL=y
CONFIG_ZTE_LCD_REPORT_CURRENT_FPS=y
CONFIG_ZTE_LCD_AOD_BRIGHTNESS_CTRL=y
CONFIG_ZTE_LCD_ACL_CTRL=y
CONFIG_ZTE_LCD_REG_DEBUG=y

# Logging
CONFIG_DUAL_SYSTEM_LOGCAT=y
CONFIG_ANDROID_LOGGER=y
CONFIG_ANDROID_ZLOG=y
CONFIG_ANDROID_ZLOG_BUFFER=y
CONFIG_ANDROID_ZLOG_LOW_MEM=y
CONFIG_VENDOR_PMLOG=y
CONFIG_PRINTK_EXT=y
CONFIG_TIME_FORMAT_ZTELOG=y
CONFIG_DYNAMIC_DEBUG=y

# Memory
# CONFIG_MEMORY_HOTPLUG is not set

# NFC
# CONFIG_NFC_QTI_I2C is not set
CONFIG_NFC_ST54J=y
CONFIG_NFC_ST54J_ESE=m

# Pagelist
CONFIG_UID_PAGELIST=y

# Platform
CONFIG_ARCH_ZTE_P875A02=y

# Power
CONFIG_POWER_VENDOR_COMMON=y
CONFIG_VENDOR_ZTE_MISC=y
CONFIG_VENDOR_CHARGER_POLICY_SERVICE=y

# SCSI
CONFIG_SCSI_PROC_FS=y
CONFIG_ZTE_UFS_INFORMATION_FUNCTION=y

# SLUB
# CONFIG_SLUB_DEBUG is not set

# Soc
CONFIG_SND_SOC_TFA98XX=y
CONFIG_SND_SOC_TFA98XX_SINGLE=y
CONFIG_VENDOR_SOC_QCOM_SRC=y

# Task
CONFIG_TASK_DELAY_ACCT=y

# Touch
CONFIG_TOUCHSCREEN_GOODIX_BRL=m
CONFIG_TP_COMMON_INTERFACE=y
CONFIG_TPD_UFP_MAC=y
CONFIG_DRM_PANEL_NOTIFIER=y
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_TOUCHSCREEN_USB_COMPOSITE is not set
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set

# Trace
CONFIG_QCOM_RTB=y
CONFIG_QCOM_RTB_QGKI=y
CONFIG_QCOM_RTB_SEPARATE_CPUS=y

# Unmov
CONFIG_BIGGER_ORDER_UNMOV=y

# Verified Boot
# CONFIG_DM_VERITY_AVB is not set

# ZRAM
CONFIG_ZRAM_WRITEBACK=y

# WiFi
CONFIG_CNSS_QCA6490=y
CONFIG_QCA_CLD_WLAN=m
